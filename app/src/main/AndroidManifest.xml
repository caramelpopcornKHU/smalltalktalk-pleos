<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 인터넷이 되면 서버 목소리, 아니면 Pleos TTS -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 내비 목적지·남은 시간 읽기 (vehicle/Navi.kt) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- 영상을 유튜브 앱(또는 브라우저)으로 열 수 있는지 확인하려면 필요 (Android 11+ 패키지 공개 범위).
         열 앱이 없으면(Pleos) 유튜브 설치 안내를 띄운다 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmalltalktalkPleos">

        <!-- AAOS Car API (주행 규제 상태). 차량이 아닌 기기에서도 설치되게 required=false -->
        <uses-library android:name="android.car" android:required="false" />

        <!-- 창 크기·방향이 바뀌어도 다시 만들지 않는다 (Compose가 반응형으로 다시 그린다) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <!-- 주행 최적화(DO) 선언: 선언하지 않으면 주행 중 앱을 쓸 수 없다(Pleos 지역별 주행 규제 정책).
                 대신 CarUxRestrictions를 받아 주행 중에는 음성과 최소 화면만 보여준다(vehicle/Driving.kt) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>