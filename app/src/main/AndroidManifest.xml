<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 인터넷이 되면 서버 목소리, 아니면 Pleos TTS -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 기어(주행·정차) 상태 조회 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmalltalktalkPleos">

        <!-- 음성 인식·합성 확인용 화면. 런처에는 없고 adb로 연다:
             adb shell am start -n com.smalltoktok.pleos/.VoiceTestActivity -->
        <activity
            android:name=".VoiceTestActivity"
            android:exported="true" />

        <!-- 창 크기·방향이 바뀌어도 다시 만들지 않는다 (Compose가 반응형으로 다시 그린다) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>